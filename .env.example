# Site settings
SITE_URL=http://localhost:8000
SITE_NAME=AI Micro-Businesses Assistant

# API settings
API_PREFIX=ai-business-assistant/api/v1

# Database settings
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=business_assistant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Toolbox settings
TOOLBOX_BASE_URL=http://0.0.0.0:5000

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_RELOAD=true

# Reasoning LLM configuration (for complex reasoning tasks)
REASONING_MODEL=your-model
REASONING_BASE_URL=https://openrouter.ai/api/v1
REASONING_API_KEY=your-reasoning-api-key
REASONING_TEMPERATURE=0.6


# Non-reasoning LLM configuration (for straightforward tasks)
BASIC_MODEL=your-model
BASIC_BASE_URL=https://openrouter.ai/api/v1
BASIC_API_KEY=your-basic-api-key
BASIC_TEMPERATURE=0.6

# Vision-language LLM configuration (for tasks requiring visual understanding)
VL_MODEL=your-model
VL_BASE_URL=https://openrouter.ai/api/v1
VL_API_KEY=your-vision-language-api-key
VL_TEMPERATURE=0.6

# Logging settings
LOG_LEVEL=INFO

# Google Gen AI
GOOGLE_GEN_AI_API_KEY=your-google-gen-ai-api-key